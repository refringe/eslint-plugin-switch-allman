{
    "name": "eslint-plugin-switch-allman",
    "version": "1.1.1",
    "description": "Enforce Allman-style braces for switch case statements.",
    "author": "Refringe <me@refringe.com>",
    "repository": {
        "type": "git",
        "url": "git@github.com:refringe/eslint-plugin-switch-allman.git"
    },
    "license": "MIT",
    "main": "lib/index.js",
    "scripts": {
        "test": "mocha tests/**/*.js",
        "coverage": "c8 --check-coverage --lines 100 --functions 100 --branches 100 --statements 100 npm test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format-check": "prettier --check .",
        "vulncheck": "npm audit --audit-level=moderate",
        "check": "npm run format-check && npm run lint && npm run vulncheck && npm run coverage"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "c8": "^12.0.0",
        "eslint": "^10.8.1",
        "globals": "^16.5.0",
        "mocha": "^11.8.0",
        "prettier": "^3.9.6"
    },
    "peerDependencies": {
        "eslint": ">=7.0.0"
    },
    "keywords": [
        "eslint",
        "eslint-plugin",
        "lint",
        "allman",
        "switch",
        "case"
    ],
    "overrides": {
        "serialize-javascript": "^7.1.0",
        "diff": "^9.0.0"
    },
    "files": [
        "lib"
    ],
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    }
}
